{
  "name": "@sandsoftwaresolutions/human-format",
  "version": "0.1.1",
  "description": "Human readable bytes, numbers, relative time, plurals, lists and truncation in Dutch, English and any language Intl knows.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "format",
    "intl",
    "bytes",
    "relative-time",
    "plural",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-human-format.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-human-format/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-human-format#readme",
  "publishConfig": {
    "access": "public"
  }
}
